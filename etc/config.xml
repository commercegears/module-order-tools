<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <softaware_ordertools>
            <general>
                <enabled>1</enabled>
            </general>
            <grid>
                <columns/>
                <test_flag>0</test_flag>
            </grid>
            <delete>
                <enabled>0</enabled>
                <statuses>canceled</statuses>
                <customer_email>hash</customer_email>
            </delete>
        </softaware_ordertools>
        <softaware_ordertools_numbers>
            <order>
                <mode>default</mode>
                <prefix/>
                <suffix/>
                <length>6</length>
                <start>1</start>
                <step>1</step>
                <reset>never</reset>
            </order>
            <invoice>
                <mode>default</mode>
                <prefix/>
                <suffix/>
                <length>6</length>
                <start>1</start>
                <step>1</step>
                <reset>never</reset>
            </invoice>
            <shipment>
                <mode>default</mode>
                <prefix/>
                <suffix/>
                <length>6</length>
                <start>1</start>
                <step>1</step>
                <reset>never</reset>
            </shipment>
            <creditmemo>
                <mode>default</mode>
                <prefix/>
                <suffix/>
                <length>6</length>
                <start>1</start>
                <step>1</step>
                <reset>never</reset>
            </creditmemo>
        </softaware_ordertools_numbers>
    </default>
</config>
