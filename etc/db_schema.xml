<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="commercegears_ordertools_counter" resource="sales" engine="innodb" comment="CommerceGears Order Tools: document number counters">
        <column xsi:type="varchar" name="entity_type" nullable="false" length="32" comment="order, invoice, shipment or creditmemo"/>
        <column xsi:type="varchar" name="pattern" nullable="false" length="64" comment="Prefix|suffix the counter belongs to"/>
        <column xsi:type="varchar" name="period" nullable="false" length="16" default="" comment="Empty, Y2026 or M2026-10"/>
        <column xsi:type="int" name="counter_value" unsigned="true" nullable="false" default="0" comment="Last value handed out"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Updated At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_type"/>
            <column name="pattern"/>
            <column name="period"/>
        </constraint>
    </table>
    <table name="commercegears_ordertools_deleted_order" resource="sales" engine="innodb" comment="CommerceGears Order Tools: deleted orders log">
        <column xsi:type="int" name="log_id" unsigned="true" nullable="false" identity="true" comment="Log ID"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" comment="Former order entity ID"/>
        <column xsi:type="varchar" name="increment_id" nullable="true" length="50" comment="Order number"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="true" comment="Store view ID"/>
        <column xsi:type="varchar" name="status" nullable="true" length="32" comment="Order status"/>
        <column xsi:type="varchar" name="state" nullable="true" length="32" comment="Order state"/>
        <column xsi:type="decimal" name="grand_total" scale="4" precision="20" unsigned="false" nullable="true" comment="Grand total (order currency)"/>
        <column xsi:type="varchar" name="order_currency_code" nullable="true" length="3" comment="Order currency"/>
        <column xsi:type="varchar" name="customer_email" nullable="true" length="255" comment="Customer email or sha256: hash"/>
        <column xsi:type="smallint" name="is_test" unsigned="true" nullable="false" default="0" comment="Was marked as a test order"/>
        <column xsi:type="varchar" name="documents" nullable="true" length="255" comment="Deleted invoices, shipments, credit memos"/>
        <column xsi:type="datetime" name="order_created_at" nullable="true" comment="Order date"/>
        <column xsi:type="int" name="admin_user_id" unsigned="true" nullable="true" comment="Admin user ID"/>
        <column xsi:type="varchar" name="admin_username" nullable="true" length="40" comment="Admin username"/>
        <column xsi:type="varchar" name="ip" nullable="true" length="45" comment="Admin IP address"/>
        <column xsi:type="timestamp" name="deleted_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Deleted At"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="log_id"/>
        </constraint>
        <index referenceId="COMMERCEGEARS_ORDERTOOLS_DELETED_ORDER_INCREMENT_ID" indexType="btree">
            <column name="increment_id"/>
        </index>
        <index referenceId="COMMERCEGEARS_ORDERTOOLS_DELETED_ORDER_DELETED_AT" indexType="btree">
            <column name="deleted_at"/>
        </index>
    </table>
    <table name="sales_order" resource="sales">
        <column xsi:type="smallint" name="sot_is_test" unsigned="true" nullable="false" default="0" comment="CommerceGears Order Tools: test order"/>
    </table>
    <table name="sales_order_grid" resource="sales">
        <column xsi:type="text" name="sot_items" nullable="true" comment="CommerceGears Order Tools: SKU x qty"/>
        <column xsi:type="varchar" name="sot_coupon_code" nullable="true" length="255" comment="CommerceGears Order Tools: coupon code"/>
        <column xsi:type="varchar" name="sot_shipping_country" nullable="true" length="2" comment="CommerceGears Order Tools: shipping country"/>
        <column xsi:type="text" name="sot_customer_note" nullable="true" comment="CommerceGears Order Tools: customer note"/>
        <column xsi:type="smallint" name="sot_is_test" unsigned="true" nullable="false" default="0" comment="CommerceGears Order Tools: test order"/>
    </table>
</schema>
