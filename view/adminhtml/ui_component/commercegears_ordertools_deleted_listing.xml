<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">commercegears_ordertools_deleted_listing.commercegears_ordertools_deleted_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>commercegears_ordertools_deleted_listing_columns</spinner>
        <deps>
            <dep>commercegears_ordertools_deleted_listing.commercegears_ordertools_deleted_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="commercegears_ordertools_deleted_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">log_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>CommerceGears_OrderTools::deleted_log</aclResource>
        <dataProvider class="CommerceGears\OrderTools\Ui\DataProvider\DeletedOrderDataProvider" name="commercegears_ordertools_deleted_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>log_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <exportButton name="export_button" class="CommerceGears\OrderTools\Ui\Component\CsvExportButton"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="commercegears_ordertools_deleted_listing_columns">
        <column name="log_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="deleted_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="20">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Deleted At</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="increment_id" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Order Number</label>
            </settings>
        </column>
        <column name="order_id" sortOrder="40">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Order ID</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="store_id" class="Magento\Store\Ui\Component\Listing\Column\Store" sortOrder="50">
            <settings>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <sortable>false</sortable>
                <label translate="true">Store View</label>
            </settings>
        </column>
        <column name="status" class="CommerceGears\OrderTools\Ui\Component\Listing\Column\OrderStatus" sortOrder="60">
            <settings>
                <filter>text</filter>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="grand_total" class="Magento\Sales\Ui\Component\Listing\Column\PurchasedPrice" sortOrder="70">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Grand Total</label>
            </settings>
        </column>
        <column name="order_currency_code" sortOrder="80">
            <settings>
                <filter>text</filter>
                <label translate="true">Currency</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="customer_email" class="CommerceGears\OrderTools\Ui\Component\Listing\Column\CustomerEmail" sortOrder="90">
            <settings>
                <filter>text</filter>
                <label translate="true">Customer Email</label>
            </settings>
        </column>
        <column name="is_test" component="Magento_Ui/js/grid/columns/select" sortOrder="100">
            <settings>
                <filter>select</filter>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <dataType>select</dataType>
                <label translate="true">Test Order</label>
            </settings>
        </column>
        <column name="documents" sortOrder="110">
            <settings>
                <filter>text</filter>
                <label translate="true">Deleted Documents</label>
            </settings>
        </column>
        <column name="order_created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="120">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Order Date</label>
                <visible>false</visible>
            </settings>
        </column>
        <column name="admin_username" sortOrder="130">
            <settings>
                <filter>text</filter>
                <label translate="true">Admin User</label>
            </settings>
        </column>
        <column name="ip" sortOrder="140">
            <settings>
                <filter>text</filter>
                <label translate="true">IP Address</label>
                <visible>false</visible>
            </settings>
        </column>
    </columns>
</listing>
