<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <listingToolbar name="listing_top">
        <massaction name="listing_massaction">
            <action name="sot_mark_test" class="CommerceGears\OrderTools\Ui\Component\MassAction\GuardedAction">
                <argument name="data" xsi:type="array">
                    <item name="feature" xsi:type="string">test_flag</item>
                </argument>
                <settings>
                    <url path="commercegears_ordertools/order/massMarkTest"/>
                    <type>sot_mark_test</type>
                    <label translate="true">Mark as Test Order</label>
                </settings>
            </action>
            <action name="sot_unmark_test" class="CommerceGears\OrderTools\Ui\Component\MassAction\GuardedAction">
                <argument name="data" xsi:type="array">
                    <item name="feature" xsi:type="string">test_flag</item>
                </argument>
                <settings>
                    <url path="commercegears_ordertools/order/massUnmarkTest"/>
                    <type>sot_unmark_test</type>
                    <label translate="true">Unmark Test Order</label>
                </settings>
            </action>
            <action name="sot_delete" class="CommerceGears\OrderTools\Ui\Component\MassAction\GuardedAction">
                <argument name="data" xsi:type="array">
                    <item name="feature" xsi:type="string">delete</item>
                </argument>
                <settings>
                    <confirm>
                        <title translate="true">Delete Orders Permanently</title>
                        <message translate="true">Permanently delete the selected orders with their invoices, shipments and credit memos? This cannot be undone. Stock, refunds and reward points are not restored. Only orders with an allowed status are deleted, at most 200 at a time.</message>
                    </confirm>
                    <url path="commercegears_ordertools/order/massDelete"/>
                    <type>sot_delete</type>
                    <label translate="true">Delete Permanently</label>
                </settings>
            </action>
        </massaction>
    </listingToolbar>
    <columns name="sales_order_columns">
        <column name="sot_items" class="CommerceGears\OrderTools\Ui\Component\Listing\Column\OptionalColumn">
            <settings>
                <filter>text</filter>
                <label translate="true">Items</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="sot_coupon_code" class="CommerceGears\OrderTools\Ui\Component\Listing\Column\OptionalColumn">
            <settings>
                <filter>text</filter>
                <label translate="true">Coupon Code</label>
            </settings>
        </column>
        <column name="sot_shipping_country" class="CommerceGears\OrderTools\Ui\Component\Listing\Column\OptionalColumn" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="CommerceGears\OrderTools\Model\Source\Country"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Shipping Country</label>
            </settings>
        </column>
        <column name="sot_customer_note" class="CommerceGears\OrderTools\Ui\Component\Listing\Column\OptionalColumn">
            <settings>
                <filter>text</filter>
                <label translate="true">Order Comment</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="sot_is_test" class="CommerceGears\OrderTools\Ui\Component\Listing\Column\OptionalColumn" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Magento\Config\Model\Config\Source\Yesno"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Test Order</label>
            </settings>
        </column>
    </columns>
</listing>
